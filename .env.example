# Backend: "apps-script" (Google Sheet + Drive) in production, "local" for development.
STORAGE_DRIVER=apps-script

# From apps-script/HUONG-DAN.md: the Web App URL and the SECRET logged by setup().
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
APPS_SCRIPT_SECRET=

# Login for /admin. Both default to "admin" when unset; set a stronger
# password here to replace it.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin
